{
  "name": "@claude-flow/performance",
  "version": "3.0.0-alpha.6",
  "type": "module",
  "description": "Performance module - benchmarking, Flash Attention validation, optimization",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./benchmarks/*": "./benchmarks/*.js"
  },
  "scripts": {
    "bench": "npm run bench:attention && npm run bench:startup",
    "bench:attention": "tsx benchmarks/attention/multi-head-attention.bench.ts && tsx benchmarks/attention/memory-efficiency.bench.ts",
    "bench:startup": "tsx benchmarks/startup/agent-spawn.bench.ts && tsx benchmarks/startup/cli-cold-start.bench.ts && tsx benchmarks/startup/cli-warm-start.bench.ts && tsx benchmarks/startup/mcp-server-init.bench.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@ruvector/attention": "latest",
    "@ruvector/sona": "latest"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v3alpha"
  }
}
